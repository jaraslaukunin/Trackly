# ─────────────────────────────────────────────────────────────────────────────
#  Trackly — пример локальной конфигурации
#
#  Скопируйте файл, подставьте свои значения и НЕ коммитьте результат:
#      cp .env.example .env
#
#  Qt-приложение читает значения в таком порядке:
#      1) переменные окружения
#      2) trackly.local.json  (см. trackly.local.example.json)
#      3) QSettings приложения
#
#  Важно: сам файл .env приложение НЕ читает. Он нужен как шпаргалка по именам
#  переменных и удобен для терминала / CI:
#      set -a && source .env && set +a && ./build/debug/TracklyDesktop
#  Для обычного запуска проще сделать trackly.local.json рядом с проектом.
#
#  В репозитории нет и не должно быть реальных ключей — только имена переменных.
# ─────────────────────────────────────────────────────────────────────────────

# ── Клиент (Qt-приложение) ───────────────────────────────────────────────────

# Адрес проекта Supabase, например https://abcdefghijklmnop.supabase.co
# Дашборд Supabase → Project Settings → API → Project URL
TRACKLY_SUPABASE_URL=

# Публичный клиентский ключ (anon / publishable).
# Безопасен ТОЛЬКО при включённых RLS-политиках на всех таблицах.
TRACKLY_SUPABASE_ANON_KEY=

# Ключ proxyAPI (OpenAI-совместимый шлюз) для AI-аналитики.
# Необязателен: без него кнопка AI вернёт ошибку «ключ не настроен».
TRACKLY_AI_PROXY_KEY=

# ── Supabase Edge Functions (серверные секреты) ──────────────────────────────
# Задаются командой `supabase secrets set ...` и доступны только функциям.
# В клиентское приложение эти значения не попадают никогда.
#
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
